\newlabel{tab:q2c-monthly-sharpe-ratios}{{4}{6}{Monthly Sharpe ratios of $xR_t^*=\hat b'xR_t$, using the same 1,190 months from July 1927 through August 2026. Variances use divisor $T$}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Coefficients in the combined BM--MOM SDF, normalized so that $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle E$}\mathaccent "0362{E}[\hat  M^*]=1$. Blue dots denote BM portfolios and red dots denote MOM portfolios. Returns are in decimals; the covariance matrix uses divisor $T$.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:q2c-combined-sdf-coefficients}{{3}{7}{Coefficients in the combined BM--MOM SDF, normalized so that $\widehat E[\hat M^*]=1$. Blue dots denote BM portfolios and red dots denote MOM portfolios. Returns are in decimals; the covariance matrix uses divisor $T$}{figure.3}{}}
