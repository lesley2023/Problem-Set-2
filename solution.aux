\newlabel{fig:q2a-bm-sdf-coefficients}{{1}{4}{Estimated coefficients $\hat b_j$ in the unconditional SDF $\hat M_t^* = \hat a - \hat b'xR_t$, normalized so that $\widehat E[\hat M^*] = 1$. The sample contains 1,190 overlapping monthly observations from July 1927 through August 2026, as specified in the analysis prompt. Returns are in decimals, and the sample covariance matrix uses divisor $T$}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Estimated coefficients $\hat  b_j$ in the unconditional SDF $\hat  M_t^* = \hat  a - \hat  b'xR_t$ for the ten momentum portfolios, normalized so that $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle E$}\mathaccent "0362{E}[\hat  M^*] = 1$. The sample contains all 1,196 overlapping monthly observations from January 1927 through August 2026, as specified in the analysis prompt. Returns are in decimals, and the sample covariance matrix uses divisor $T$, as in part (a).}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:q2b-mom-sdf-coefficients}{{2}{5}{Estimated coefficients $\hat b_j$ in the unconditional SDF $\hat M_t^* = \hat a - \hat b'xR_t$ for the ten momentum portfolios, normalized so that $\widehat E[\hat M^*] = 1$. The sample contains all 1,196 overlapping monthly observations from January 1927 through August 2026, as specified in the analysis prompt. Returns are in decimals, and the sample covariance matrix uses divisor $T$, as in part (a)}{figure.2}{}}
