\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Estimated BM SDF intercept and coefficients, rounded to four decimal places. Each $\hat  b_j$ corresponds to BM decile $j$; estimation uses decimal monthly excess returns.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:q2a-bm-sdf-parameters}{{1}{4}{Estimated BM SDF intercept and coefficients, rounded to four decimal places. Each $\hat b_j$ corresponds to BM decile $j$; estimation uses decimal monthly excess returns}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Estimated coefficients $\hat  b_j$ in the unconditional SDF $\hat  M_t^* = \hat  a - \hat  b'xR_t$, normalized so that $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle E$}\mathaccent "0362{E}[\hat  M^*] = 1$. The sample contains 1,190 overlapping monthly observations from July 1927 through August 2026, as specified in the analysis prompt. Returns are in decimals, and the sample covariance matrix uses divisor $T$.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:q2a-bm-sdf-coefficients}{{1}{4}{Estimated coefficients $\hat b_j$ in the unconditional SDF $\hat M_t^* = \hat a - \hat b'xR_t$, normalized so that $\widehat E[\hat M^*] = 1$. The sample contains 1,190 overlapping monthly observations from July 1927 through August 2026, as specified in the analysis prompt. Returns are in decimals, and the sample covariance matrix uses divisor $T$}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Estimated MOM SDF intercept and coefficients, rounded to four decimal places. Each $\hat  b_j$ corresponds to MOM decile $j$; estimation uses decimal monthly excess returns.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:q2b-mom-sdf-parameters}{{2}{5}{Estimated MOM SDF intercept and coefficients, rounded to four decimal places. Each $\hat b_j$ corresponds to MOM decile $j$; estimation uses decimal monthly excess returns}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Estimated coefficients $\hat  b_j$ in the unconditional SDF $\hat  M_t^* = \hat  a - \hat  b'xR_t$ for the ten momentum portfolios, normalized so that $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle E$}\mathaccent "0362{E}[\hat  M^*] = 1$. The sample contains 1,190 overlapping monthly observations from July 1927 through August 2026, as specified in the analysis prompt. Returns are in decimals, and the sample covariance matrix uses divisor $T$, as in part (a).}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:q2b-mom-sdf-coefficients}{{2}{5}{Estimated coefficients $\hat b_j$ in the unconditional SDF $\hat M_t^* = \hat a - \hat b'xR_t$ for the ten momentum portfolios, normalized so that $\widehat E[\hat M^*] = 1$. The sample contains 1,190 overlapping monthly observations from July 1927 through August 2026, as specified in the analysis prompt. Returns are in decimals, and the sample covariance matrix uses divisor $T$, as in part (a)}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Combined SDF intercept and coefficients, rounded to four decimal places. The first ten coefficients correspond to BM portfolios and the next ten to MOM portfolios. Estimation uses decimal excess returns.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:q2c-combined-sdf-parameters}{{3}{6}{Combined SDF intercept and coefficients, rounded to four decimal places. The first ten coefficients correspond to BM portfolios and the next ten to MOM portfolios. Estimation uses decimal excess returns}{table.3}{}}
